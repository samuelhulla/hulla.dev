{
  "name": "hulla-dev",
  "version": "0.0.0-beta.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/report-bundles.mjs",
    "preview": "astro preview",
    "check": "astro check && bun run check:native",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "bun test tests/*.test.ts",
    "test:e2e": "bun run build && playwright test",
    "ui:sync": "node scripts/ui-sync.mjs",
    "ui:check": "node scripts/ui-sync.mjs --check",
    "api:coverage": "bun scripts/check-api-coverage.ts",
    "api:check": "bun run api:coverage && node scripts/check-api-examples.mjs",
    "self-contained:check": "node scripts/check-self-contained.mjs --build",
    "cv:pdf": "node scripts/export-cv-pdf.mjs",
    "verify": "bun run format:check && bun run lint && bun run check && bun run ui:check && bun run api:check && bun run self-contained:check && bun run test && bun run build && bun run test:e2e",
    "check:native": "tsc --project tsconfig.native.json --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/solid-js": "^7.0.2",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@hulla/style": "0.4.0",
    "@lucide/astro": "^1.44.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "pagefind": "^1.5.2",
    "shiki": "^4.4.3",
    "solid-js": "^1.9.15",
    "cn": "0.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@hulla/ui": "link:@hulla/ui",
    "@iconify-json/logos": "^1.2.14",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^17.12.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.6.1"
  }
}
