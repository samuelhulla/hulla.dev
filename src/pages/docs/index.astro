---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteHeader from '@/components/site/SiteHeader.astro'
import SiteFooter from '@/components/site/SiteFooter.astro'
import PackageDirectory from '@/components/site/PackageDirectory.astro'
---

<BaseLayout
  title="Documentation"
  description="Try the @hulla packages: typed HTTP contracts, live PostgreSQL queries, shared UI components, and TypeScript tools."
  markdownUrl="/docs.md">
  <SiteHeader />
  <main id="main" class="home-frame py-16">
    <p class="eyebrow">@hulla packages</p>
    <h1 class="docs-title">Documentation</h1>
    <p class="docs-description mb-8">
      Choose a package to open its documentation. Each introduction explains the
      package, with a working example and a path to your first project.
    </p>
    <p class="mb-10 text-muted-foreground">
      Prefer to start with a project?{' '}
      <a class="text-link" href="/guides">
        Follow a guide
      </a>
      . Working with a coding agent?{' '}
      <a class="text-link" href="/docs/cli/agent-skills">
        Install package skills
      </a>
      .
    </p>
    <section aria-labelledby="package-docs">
      <h2 id="package-docs" class="mb-5 text-2xl font-semibold tracking-tight">
        Package documentation
      </h2>
      <PackageDirectory />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
