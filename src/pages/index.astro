---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteHeader from '@/components/site/SiteHeader.astro'
import SiteFooter from '@/components/site/SiteFooter.astro'
import Card from '@/components/card/card.astro'
import CardHeader from '@/components/card/card-header.astro'
import CardTitle from '@/components/card/card-title.astro'
import CardDescription from '@/components/card/card-description.astro'
import CardContent from '@/components/card/card-content.astro'
import Badge from '@/components/badge/badge.astro'
import DocsCodeBlock from '@/components/docs/DocsCodeBlock.astro'
import PackageIcon from '@/components/site/PackageIcon.astro'
const example = `const contract = defineContract({
  basePath: '/api',
  routes: {
    user: route.get('/users/:id', {
      params: z.object({ id: z.string() }),
      responses: { 200: response.json(user) },
    }),
  },
})

const result = await api.user({ params: { id: 'ada' } })`
---

<BaseLayout
  title="hulla.dev"
  description="Samuel Hulla — software engineer, engineering leader, and maintainer of the @hulla/* open-source packages.">
  <SiteHeader />
  <main id="main" class="home-frame">
    <section class="home-hero">
      <div>
        <p class="eyebrow">Samuel Hulla / Software engineer</p>
        <h1 class="home-title">
          Good software.
          <br />
          From the
          <br />
          <span class="text-muted-foreground">inside out.</span>
        </h1>
        <p class="home-intro">
          I build products, lead engineering teams, and turn the useful parts
          into open source. Based in Prague. Working everywhere.
        </p>
        <div class="mt-8 flex flex-wrap gap-6 text-sm">
          <a class="text-link" href="/docs">
            Explore the docs →
          </a>
          <a class="text-link" href="/cv">
            About my work ↗
          </a>
        </div>
      </div>
      <div>
        <div class="mb-5 flex items-center justify-between gap-4">
          <span class="eyebrow">In the workshop</span>
          <Badge size="sm" variant="primary">
            Open source
          </Badge>
        </div>
        <Card>
          <CardHeader>
            <CardTitle aria-level={2}>
              <span class="flex items-center gap-2.5">
                <PackageIcon kind="api" size={20} class="text-primary-text" />
                <span>@hulla/api</span>
              </span>
            </CardTitle>
            <CardDescription>
              One HTTP contract. Every application boundary.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <DocsCodeBlock code={example} language="ts" filename="users.ts" />
            <a class="text-link text-sm" href="/docs/api/quick-start">
              Define your first contract →
            </a>
          </CardContent>
        </Card>
      </div>
    </section>
    <section class="home-section">
      <p class="eyebrow">The packages</p>
      <h2 class="home-section-title">Small pieces. A considered whole.</h2>
      <div class="grid gap-5 md:grid-cols-3">
        <Card>
          <CardHeader>
            <CardTitle>
              <a class="flex items-center gap-2.5" href="/docs/api">
                <PackageIcon kind="api" size={20} class="text-primary-text" />
                <span>@hulla/api ↗</span>
              </a>
            </CardTitle>
            <CardDescription>
              Declare HTTP contracts, implement exhaustive servers, and call
              them through typed transports.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <a class="text-link text-sm" href="/docs/api">
              Read the documentation
            </a>
          </CardContent>
        </Card>
        <Card>
          <CardHeader>
            <CardTitle>
              <a class="flex items-center gap-2.5" href="/docs/ui">
                <PackageIcon kind="ui" size={20} class="text-primary-text" />
                <span>@hulla/ui ↗</span>
              </a>
            </CardTitle>
            <CardDescription>
              Composable components for Astro, React, and Solid. Shared design,
              source you own.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <a class="text-link text-sm" href="/docs/ui">
              Explore components & styling
            </a>
          </CardContent>
        </Card>
        <Card>
          <CardHeader>
            <CardTitle>
              <a class="flex items-center gap-2.5" href="/docs/cli">
                <PackageIcon kind="cli" size={20} class="text-primary-text" />
                <span>hulla CLI ↗</span>
              </a>
            </CardTitle>
            <CardDescription>
              Generate and synchronize source-owned integrations across the
              @hulla/* package ecosystem.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <a class="text-link text-sm" href="/docs/cli">
              Explore the CLI
            </a>
          </CardContent>
        </Card>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
