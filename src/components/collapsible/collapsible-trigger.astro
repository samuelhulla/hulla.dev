---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'summary'>

const { class: className, ...props } = Astro.props as Props
---

<summary
  {...props}
  data-slot="collapsible-trigger"
  class={cn(
    'flex min-h-9 w-full list-none items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm font-medium text-foreground transition-colors duration-150 after:ml-auto after:size-2 after:shrink-0 after:-translate-x-0.5 after:-rotate-45 after:border-r after:border-b after:border-current after:transition-transform after:duration-180 hover:bg-hover-surface group-open/collapsible:after:translate-x-0 group-open/collapsible:after:-translate-y-0.5 group-open/collapsible:after:rotate-45 motion-reduce:transition-none motion-reduce:after:transition-none [&::-webkit-details-marker]:hidden',
    className
  )}>
  <slot />
</summary>
