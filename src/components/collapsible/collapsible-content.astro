---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'> & {
  scope?: 'default' | 'nested'
}

const { class: className, scope = 'default', ...props } = Astro.props as Props
---

<div
  {...props}
  data-slot="collapsible-content"
  class={cn(
    'min-w-0 -translate-y-0.5 opacity-0 transition-[opacity,translate] duration-150 ease-out motion-reduce:translate-y-0 motion-reduce:transition-none',
    scope === 'nested'
      ? 'group-open/nested-collapsible:translate-y-0 group-open/nested-collapsible:opacity-100'
      : 'group-open/collapsible:translate-y-0 group-open/collapsible:opacity-100',
    className
  )}>
  <slot />
</div>
