---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'
type Props = HTMLAttributes<'nav'> & {
  for: string
  /** Top viewport inset in pixels. Match the sections' scroll-margin-top. */
  offset?: number
}
const {
  class: className,
  for: target,
  offset = 96,
  ...props
} = Astro.props as Props
---

<hulla-table-of-contents class="contents">
  <nav
    aria-label="On this page"
    {...props}
    data-slot="table-of-contents"
    data-toc-for={target}
    data-toc-offset={offset}
    class={cn('grid gap-3 text-sm text-foreground', className)}>
    <slot />
    <ol
      data-slot="table-of-contents-list"
      class="m-0 grid list-none gap-1 border-l border-border p-0"></ol>
  </nav>
</hulla-table-of-contents>
<script>
  import { connectTableOfContents } from '@/lib/table-of-contents'
  if (!customElements.get('hulla-table-of-contents')) {
    customElements.define(
      'hulla-table-of-contents',
      class extends HTMLElement {
        controller?: ReturnType<typeof connectTableOfContents>
        connectedCallback() {
          const nav = this.querySelector<HTMLElement>(
            '[data-slot=table-of-contents]'
          )
          if (nav) this.controller ??= connectTableOfContents(nav)
        }
        disconnectedCallback() {
          this.controller?.destroy()
          this.controller = undefined
        }
      }
    )
  }
</script>
