---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'
type Props = HTMLAttributes<'div'> & { id: string; label: string }
const { class: className, id, label, ...props } = Astro.props as Props
---

<div
  tabindex="-1"
  {...props}
  id={id}
  data-slot="table-of-contents-section"
  data-toc-label={label}
  class={cn('scroll-mt-24', className)}>
  <slot />
</div>
