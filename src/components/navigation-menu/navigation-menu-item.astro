---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'li'> & {
  value?: string
}

const { class: className, value, ...props } = Astro.props as Props
---

<li
  {...props}
  data-slot="navigation-menu-item"
  data-state="closed"
  data-value={value}
  class={cn('contents', className)}>
  <slot />
</li>
