---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'strong'>
const { class: className, ...props } = Astro.props as Props
---

<strong
  {...props}
  data-slot="link-card-title"
  class={cn('text-sm font-medium tracking-[-0.015em]', className)}>
  <slot />
</strong>
