---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'summary'>

const { class: className, ...props } = Astro.props as Props
---

<summary
  {...props}
  data-slot="sidebar-group-trigger"
  class={cn(
    'flex min-h-8 w-full min-w-0 list-none items-center gap-2 rounded-[4px] px-2.5 py-1.5 font-mono text-[0.6875rem] leading-snug font-medium text-balance tracking-[0.08em] text-muted-foreground uppercase transition-colors duration-150 after:ml-auto after:size-1.5 after:shrink-0 after:-translate-x-0.5 after:-rotate-45 after:border-r after:border-b after:border-current after:transition-transform after:duration-200 hover:bg-hover-surface hover:text-foreground [details[open]>&]:after:translate-x-0 [details[open]>&]:after:-translate-y-0.5 [details[open]>&]:after:rotate-45 motion-reduce:transition-none motion-reduce:after:transition-none [&>span]:min-w-0 [&>svg]:shrink-0 [&::-webkit-details-marker]:hidden',
    className
  )}>
  <slot />
</summary>
