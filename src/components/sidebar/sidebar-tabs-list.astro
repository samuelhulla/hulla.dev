---
import { cn } from '@/lib/style'
import TabsList from '../tabs/tabs-list.astro'
import type { ComponentProps } from 'astro/types'

type Props = ComponentProps<typeof TabsList>

const { class: className, ...props } = Astro.props as Props
---

<TabsList
  {...props}
  class={cn(
    'shrink-0 [&]:gap-0 [&]:px-0 [&>[data-slot=tabs-trigger]]:min-w-0 [&>[data-slot=tabs-trigger]]:flex-1 [&>[data-slot=tabs-trigger]]:rounded-none [&>[data-slot=tabs-trigger]]:px-2',
    className
  )}>
  <slot />
</TabsList>
