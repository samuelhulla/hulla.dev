---
import Stepper from '@/components/stepper/stepper.astro'
import StepperItem from '@/components/stepper/stepper-item.astro'
import StepperIndicator from '@/components/stepper/stepper-indicator.astro'
import StepperContent from '@/components/stepper/stepper-content.astro'
import StepperPanel from '@/components/stepper/stepper-panel.astro'
import DocsCodeBlock from './DocsCodeBlock.astro'
type Props = {
  label: string
  steps: { title: string; description: string; example?: string }[]
}
const { label, steps } = Astro.props
---

<section class="docs-example" aria-label={label} data-component-boundary>
  <Stepper variant="ordered" aria-label={label}>
    {steps.map((step, index) => (
      <StepperItem>
        <StepperIndicator>{index + 1}</StepperIndicator>
        <StepperContent>
          <span>{step.title}</span>
        </StepperContent>
        <StepperPanel>
          <p>{step.description}</p>
          {step.example && <DocsCodeBlock code={step.example} language="ts" />}
        </StepperPanel>
      </StepperItem>
    ))}
  </Stepper>
</section>
