---
import LinkCard from '@/components/link-card/link-card.astro'
import LinkCardContent from '@/components/link-card/link-card-content.astro'
import LinkCardTitle from '@/components/link-card/link-card-title.astro'
import LinkCardDescription from '@/components/link-card/link-card-description.astro'
import { ArrowUpRight } from '@lucide/astro'

type Props = {
  label: string
  items: readonly { title: string; href: string; description: string }[]
}
const { label, items } = Astro.props
---

<nav class="docs-example" aria-label={label} data-component-boundary>
  <ul role="list" class="m-0 grid list-none gap-2 p-0 sm:grid-cols-2">
    {items.map((item) => (
      <li class="min-w-0">
        <LinkCard href={item.href}>
          <LinkCardContent>
            <LinkCardTitle>{item.title}</LinkCardTitle>
            <LinkCardDescription>{item.description}</LinkCardDescription>
          </LinkCardContent>
          <ArrowUpRight
            class="mt-0.5 ml-auto size-4 shrink-0 text-muted-foreground"
            aria-hidden="true"
          />
        </LinkCard>
      </li>
    ))}
  </ul>
</nav>
