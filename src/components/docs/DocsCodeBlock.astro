---
import type { BundledLanguage } from 'shiki'
import { bundledLanguages } from 'shiki'
import Button from '@/components/button/button.astro'
import CodeBlock from '@/components/code/code-block.astro'
import CodeBlockActions from '@/components/code/code-block-actions.astro'
import CodeBlockBody from '@/components/code/code-block-body.astro'
import CodeBlockContent from '@/components/code/code-block-content.astro'
import CodeBlockDescription from '@/components/code/code-block-description.astro'
import CodeBlockFooter from '@/components/code/code-block-footer.astro'
import CodeBlockHeader from '@/components/code/code-block-header.astro'
import CodeBlockPath from '@/components/code/code-block-path.astro'
import CodeBlockTitle from '@/components/code/code-block-title.astro'
import { createShikiCodeHighlighter } from '@/components/code-highlighter-shiki/code-highlighter-shiki'
import { Copy } from '@lucide/astro'
import FileIcon from '@/components/site/FileIcon.astro'
type Props = {
  class?: string
  embedded?: boolean
  code: string
  language?: string
  filename?: string
  caption?: string
  lineNumbers?: boolean
  highlighted?: string
  focused?: string
  inserted?: string
  deleted?: string
  error?: string
  warning?: string
}
const {
  class: className,
  embedded = false,
  code,
  language = 'ts',
  filename,
  caption,
  lineNumbers = false,
  highlighted: highlightedRange,
  focused: focusedRange,
  inserted: insertedRange,
  deleted: deletedRange,
  error: errorRange,
  warning: warningRange,
} = Astro.props
const normalized = code.replace(/\t/g, '  ').replace(/\s+$/g, '')
const lines = normalized.replace(/^\n+/, '').split('\n')
if (!normalized.startsWith('\n')) lines[0] = lines[0]?.trimStart() ?? ''
const nonempty = lines.filter((line) => line.trim())
const indent =
  normalized.startsWith('\n') && nonempty.length
    ? Math.min(...nonempty.map((line) => line.match(/^ */)![0].length))
    : 0
const source = lines.map((line) => line.slice(indent)).join('\n')
const sourceLines = source.split('\n')
const parseLineRange = (range?: string) => {
  if (!range) return undefined
  const result = new Set<number>()
  for (const part of range.split(',')) {
    const [startValue, endValue] = part.trim().split('-')
    const start = Number(startValue)
    const end = endValue === undefined ? start : Number(endValue)
    if (
      !Number.isInteger(start) ||
      !Number.isInteger(end) ||
      start < 1 ||
      end < start
    )
      continue
    for (let line = start; line <= end; line += 1) result.add(line)
  }
  return result.size ? [...result] : undefined
}
const highlightedLines = parseLineRange(highlightedRange)
const focusedLines = parseLineRange(focusedRange)
const insertedLines =
  parseLineRange(insertedRange) ??
  (language === 'diff'
    ? sourceLines.flatMap((line, index) =>
        line.startsWith('+') && !line.startsWith('+++') ? [index + 1] : []
      )
    : undefined)
const deletedLines =
  parseLineRange(deletedRange) ??
  (language === 'diff'
    ? sourceLines.flatMap((line, index) =>
        line.startsWith('-') && !line.startsWith('---') ? [index + 1] : []
      )
    : undefined)
const errorLines = parseLineRange(errorRange)
const warningLines = parseLineRange(warningRange)
const languageAliases: Record<string, string> = {
  cjs: 'js',
  cts: 'ts',
  htm: 'html',
  mjs: 'js',
  mts: 'ts',
  shell: 'bash',
  yml: 'yaml',
}
const languageFromFilename = (value?: string) => {
  const extension = value?.match(/\.([^./]+)$/)?.[1]?.toLowerCase()
  if (!extension) return undefined
  const candidate = languageAliases[extension] ?? extension
  return candidate in bundledLanguages
    ? (candidate as BundledLanguage)
    : undefined
}
const diffLanguage =
  language === 'diff' ? languageFromFilename(filename) : undefined
const syntaxLanguage = diffLanguage ?? language
const known = syntaxLanguage in bundledLanguages
const highlighter = known
  ? await createShikiCodeHighlighter({
      languages: [syntaxLanguage as BundledLanguage],
    })
  : undefined
const highlighted = highlighter
  ? diffLanguage
    ? highlighter.highlightDiff(source, { language: diffLanguage })
    : highlighter.highlight(source, {
        language: syntaxLanguage as BundledLanguage,
      })
  : undefined
const label =
  filename ??
  (language === 'sh' || language === 'bash'
    ? 'Terminal'
    : language === 'ts'
      ? 'TypeScript'
      : language)
---

{embedded ? (
  <>
    <CodeBlockPath>
      <CodeBlockTitle class="flex items-center gap-2">
        <FileIcon filename={filename ?? label} language={syntaxLanguage} />
        <span class="truncate">{label}</span>
      </CodeBlockTitle>
      <CodeBlockActions>
        <Button
          size="sm"
          variant="ghost"
          data-copy={source}
          aria-label={`Copy ${label}`}>
          <Copy size={14} aria-hidden="true" />
          <span data-copy-label>Copy</span>
        </Button>
      </CodeBlockActions>
    </CodeBlockPath>
    <CodeBlockBody class={className}>
      <CodeBlockContent
        {highlighted}
        code={source}
        {language}
        {lineNumbers}
        {highlightedLines}
        {focusedLines}
        {insertedLines}
        {deletedLines}
        {errorLines}
        {warningLines}
      />
    </CodeBlockBody>
    {caption && (
      <CodeBlockFooter>
        <CodeBlockDescription>{caption}</CodeBlockDescription>
      </CodeBlockFooter>
    )}
  </>
) : (
  <div class:list={['docs-example', className]} data-component-boundary>
    <CodeBlock>
      <CodeBlockHeader>
        <CodeBlockTitle class="flex items-center gap-2">
          <FileIcon filename={filename ?? label} language={syntaxLanguage} />
          <span class="truncate">{label}</span>
        </CodeBlockTitle>
        <CodeBlockActions>
          <Button
            size="sm"
            variant="ghost"
            data-copy={source}
            aria-label={`Copy ${label}`}>
            <Copy size={14} aria-hidden="true" />
            <span data-copy-label>Copy</span>
          </Button>
        </CodeBlockActions>
      </CodeBlockHeader>
      <CodeBlockBody>
        <CodeBlockContent
          {highlighted}
          code={source}
          {language}
          {lineNumbers}
          {highlightedLines}
          {focusedLines}
          {insertedLines}
          {deletedLines}
          {errorLines}
          {warningLines}
        />
      </CodeBlockBody>
      {caption && (
        <CodeBlockFooter>
          <CodeBlockDescription>{caption}</CodeBlockDescription>
        </CodeBlockFooter>
      )}
    </CodeBlock>
  </div>
)}
<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-copy]')
    .forEach((button) =>
      button.addEventListener('click', async () => {
        const label = button.querySelector('[data-copy-label]')
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '')
          if (label) label.textContent = 'Copied'
        } catch {
          if (label) label.textContent = 'Copy failed'
        }
        setTimeout(() => {
          if (label) label.textContent = 'Copy'
        }, 1800)
      })
    )
</script>
