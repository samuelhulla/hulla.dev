---
import { apiDocNavigation, docPackages, findDocPackage } from '@/data/docs'
import Sidebar from '@/components/sidebar/sidebar.astro'
import SidebarHeader from '@/components/sidebar/sidebar-header.astro'
import SidebarContent from '@/components/sidebar/sidebar-content.astro'
import SidebarGroup from '@/components/sidebar/sidebar-group.astro'
import SidebarGroupTrigger from '@/components/sidebar/sidebar-group-trigger.astro'
import SidebarMenu from '@/components/sidebar/sidebar-menu.astro'
import SidebarMenuItem from '@/components/sidebar/sidebar-menu-item.astro'
import SidebarMenuLink from '@/components/sidebar/sidebar-menu-link.astro'
import SidebarMenuTrigger from '@/components/sidebar/sidebar-menu-trigger.astro'
import Collapsible from '@/components/collapsible/collapsible.astro'
import CollapsibleContent from '@/components/collapsible/collapsible-content.astro'
import Tabs from '@/components/tabs/tabs.astro'
import TabsList from '@/components/tabs/tabs-list.astro'
import TabsTrigger from '@/components/tabs/tabs-trigger.astro'
import TabsContent from '@/components/tabs/tabs-content.astro'
import PackageIcon from '@/components/site/PackageIcon.astro'
import {
  BookOpen,
  Braces,
  Cable,
  Check,
  ChevronDown,
  Layers,
  PanelsTopLeft,
  PlugZap,
  Server,
  SquareTerminal,
} from '@lucide/astro'

type Props = { pathname: string }
const { pathname } = Astro.props

const packages = docPackages
const activePackage = findDocPackage(pathname) ?? packages[0]!
const areas = [
  {
    value: 'guides',
    label: 'Guides',
    groups: activePackage.groups.filter((group) => group.area !== 'reference'),
  },
  {
    value: 'reference',
    label: 'Reference',
    groups: activePackage.groups.filter((group) => group.area === 'reference'),
  },
].filter((area) => area.groups.length > 0)

const sectionIcons = {
  'Start here': BookOpen,
  Fundamentals: Layers,
  Server,
  Client: Cable,
  Integrations: PlugZap,
  'OpenAPI tooling': Braces,
  Reference: SquareTerminal,
} as const
---

<Sidebar
  class="min-[96rem]:bg-transparent"
  aria-label="Package documentation navigation">
  <SidebarHeader class="docs-package-header relative">
    <details class="docs-package-picker group/package-selector relative">
      <summary
        class="docs-package-selector"
        aria-label={`Select package, current package ${activePackage.title}`}
        data-package-kind={activePackage.kind}>
        <span class="docs-package-selector-icon">
          <PackageIcon kind={activePackage.kind} size={17} />
        </span>
        <span class="docs-package-selector-copy">
          <span class="docs-package-selector-label">Package</span>
          <span class="docs-package-selector-name">{activePackage.title}</span>
        </span>
        {activePackage.status && (
          <span class="docs-package-status">
            <span aria-hidden="true"></span>
            {activePackage.status}
          </span>
        )}
        <span class="docs-package-chevron">
          <ChevronDown size={14} aria-hidden="true" />
        </span>
      </summary>
      <div class="docs-package-menu">
        <div class="docs-package-menu-heading">
          <span>Switch package</span>
          <span>{packages.length} packages</span>
        </div>
        {packages.map((pkg) => (
          <a
            href={pkg.href}
            aria-label={`${pkg.title}: ${pkg.description}${pkg.status ? `, ${pkg.status}` : ''}`}
            aria-current={pkg.href === activePackage.href ? 'page' : undefined}
            class="docs-package-option"
            data-package-kind={pkg.kind}>
            <span class="docs-package-option-icon">
              <PackageIcon kind={pkg.kind} size={16} />
            </span>
            <span class="docs-package-option-copy">
              <span class="docs-package-option-name">{pkg.title}</span>
              <span class="docs-package-option-description">
                {pkg.description}
              </span>
            </span>
            {pkg.status && (
              <span class="docs-package-option-status">{pkg.status}</span>
            )}
            {pkg.href === activePackage.href && (
              <Check
                class="docs-package-option-check"
                size={14}
                stroke-width={2}
                aria-hidden="true"
              />
            )}
          </a>
        ))}
      </div>
    </details>
  </SidebarHeader>

  <SidebarContent class="p-3">
    <Tabs
      defaultValue="documentation"
      class="gap-2"
      data-docs-area-tabs={pathname}>
      <TabsList aria-label="Documentation area" class="docs-area-tabs">
        <TabsTrigger value="documentation" class="docs-area-tab">
          Documentation
        </TabsTrigger>
        {areas.map((area) => (
          <TabsTrigger value={area.value} class="docs-area-tab">
            {area.label}
          </TabsTrigger>
        ))}
      </TabsList>

      <TabsContent value="documentation" class="pt-1" tabindex={0}>
        {activePackage.kind === 'api' && (
          <div class="grid gap-1">
            {apiDocNavigation.map((section) => {
              const isCategory =
                section.groups.length > 1 ||
                section.groups[0]?.title !== section.title
              const isSectionActive = section.groups.some(
                (group) =>
                  pathname === group.href ||
                  group.entries.some((entry) => pathname === entry.href)
              )
              const SectionIcon =
                sectionIcons[section.title as keyof typeof sectionIcons]

              if (isCategory) {
                return (
                  <SidebarGroup class="py-0.5">
                    <Collapsible
                      open={isSectionActive}
                      data-docs-sidebar-group={`section:${section.title.toLowerCase()}`}
                      data-docs-sidebar-package={activePackage.kind}
                      data-docs-sidebar-active={
                        isSectionActive ? 'true' : undefined
                      }>
                      <SidebarGroupTrigger class="min-h-9 rounded-md px-2 text-[0.65rem]">
                        <SectionIcon
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                        <span>{section.title}</span>
                      </SidebarGroupTrigger>
                      <CollapsibleContent>
                        <SidebarMenu class="mt-0.5" lines="all">
                          {section.groups.map((group) => {
                            const isGroupActive =
                              pathname === group.href ||
                              group.entries.some(
                                (entry) => pathname === entry.href
                              )

                            return (
                              <SidebarMenuItem>
                                <Collapsible
                                  scope="nested"
                                  open={isGroupActive}
                                  data-docs-sidebar-group={group.href}
                                  data-docs-sidebar-package={activePackage.kind}
                                  data-docs-sidebar-active={
                                    isGroupActive ? 'true' : undefined
                                  }>
                                  <SidebarMenuTrigger
                                    scope="nested"
                                    class="min-h-8 py-1 text-[0.8125rem] font-medium text-foreground">
                                    {group.title}
                                  </SidebarMenuTrigger>
                                  <CollapsibleContent scope="nested">
                                    <SidebarMenu>
                                      <SidebarMenuItem>
                                        <SidebarMenuLink
                                          href={group.href}
                                          aria-current={
                                            pathname === group.href
                                              ? 'page'
                                              : undefined
                                          }>
                                          Overview
                                        </SidebarMenuLink>
                                      </SidebarMenuItem>
                                      {group.entries.map((entry) => (
                                        <SidebarMenuItem>
                                          <SidebarMenuLink
                                            href={entry.href}
                                            aria-current={
                                              pathname === entry.href
                                                ? 'page'
                                                : undefined
                                            }>
                                            {entry.title}
                                          </SidebarMenuLink>
                                        </SidebarMenuItem>
                                      ))}
                                    </SidebarMenu>
                                  </CollapsibleContent>
                                </Collapsible>
                              </SidebarMenuItem>
                            )
                          })}
                        </SidebarMenu>
                      </CollapsibleContent>
                    </Collapsible>
                  </SidebarGroup>
                )
              }

              const group = section.groups[0]!
              return (
                <SidebarGroup class="py-0.5">
                  <Collapsible
                    open={isSectionActive}
                    data-docs-sidebar-group={group.href}
                    data-docs-sidebar-package={activePackage.kind}
                    data-docs-sidebar-active={
                      isSectionActive ? 'true' : undefined
                    }>
                    <SidebarGroupTrigger class="min-h-9 rounded-md px-2 text-[0.65rem]">
                      <SectionIcon
                        size={15}
                        stroke-width={1.7}
                        aria-hidden="true"
                      />
                      <span>{group.title}</span>
                    </SidebarGroupTrigger>
                    <CollapsibleContent>
                      <SidebarMenu class="mt-0.5">
                        <SidebarMenuItem>
                          <SidebarMenuLink
                            href={group.href}
                            aria-current={
                              pathname === group.href ? 'page' : undefined
                            }>
                            Overview
                          </SidebarMenuLink>
                        </SidebarMenuItem>
                        {group.entries.map((entry) => (
                          <SidebarMenuItem>
                            <SidebarMenuLink
                              href={entry.href}
                              aria-current={
                                pathname === entry.href ? 'page' : undefined
                              }>
                              {entry.title}
                            </SidebarMenuLink>
                          </SidebarMenuItem>
                        ))}
                      </SidebarMenu>
                    </CollapsibleContent>
                  </Collapsible>
                </SidebarGroup>
              )
            })}
          </div>
        )}

        {activePackage.kind === 'ui' && (
          <SidebarGroup class="py-0.5">
            <Collapsible
              open
              data-docs-sidebar-group="/docs/ui"
              data-docs-sidebar-package={activePackage.kind}
              data-docs-sidebar-active="true">
              <SidebarGroupTrigger>
                <PanelsTopLeft size={15} aria-hidden="true" />
                <span>Components</span>
              </SidebarGroupTrigger>
              <CollapsibleContent>
                <SidebarMenu>
                  <SidebarMenuItem>
                    <SidebarMenuLink
                      href="/docs/ui"
                      aria-current={
                        pathname === '/docs/ui' ? 'page' : undefined
                      }>
                      Components & styling
                    </SidebarMenuLink>
                  </SidebarMenuItem>
                </SidebarMenu>
              </CollapsibleContent>
            </Collapsible>
          </SidebarGroup>
        )}

        {activePackage.kind !== 'api' && activePackage.kind !== 'ui' && (
          <div class="grid gap-1">
            {activePackage.groups.map((group) => (
              <SidebarGroup class="py-0.5">
                <Collapsible
                  open
                  data-docs-sidebar-group={group.href}
                  data-docs-sidebar-package={activePackage.kind}
                  data-docs-sidebar-active={
                    group.entries.some((entry) => pathname === entry.href)
                      ? 'true'
                      : undefined
                  }>
                  <SidebarGroupTrigger>
                    <BookOpen size={15} aria-hidden="true" />
                    <span>{group.title}</span>
                  </SidebarGroupTrigger>
                  <CollapsibleContent>
                    <SidebarMenu>
                      {group.entries.map((entry) => (
                        <SidebarMenuItem>
                          <SidebarMenuLink
                            href={entry.href}
                            aria-current={
                              pathname === entry.href ? 'page' : undefined
                            }>
                            {entry.title}
                          </SidebarMenuLink>
                        </SidebarMenuItem>
                      ))}
                    </SidebarMenu>
                  </CollapsibleContent>
                </Collapsible>
              </SidebarGroup>
            ))}
          </div>
        )}
      </TabsContent>

      {areas.map((area) => (
        <TabsContent value={area.value} class="pt-1" tabindex={0}>
          <SidebarMenu>
            {area.groups
              .flatMap((group) => group.entries)
              .map((entry) => (
                <SidebarMenuItem>
                  <SidebarMenuLink href={entry.href}>
                    {entry.title}
                  </SidebarMenuLink>
                </SidebarMenuItem>
              ))}
          </SidebarMenu>
        </TabsContent>
      ))}
    </Tabs>
  </SidebarContent>
</Sidebar>

<script>
  import { connectDocsSidebarState } from '@/lib/docs-sidebar-state'
  import {
    TABS_VALUE_CHANGE_EVENT,
    type TabsValueChangeDetail,
  } from '@/lib/tabs'

  connectDocsSidebarState()

  for (const navigation of document.querySelectorAll<HTMLElement>(
    '[data-docs-area-tabs]'
  )) {
    navigation.addEventListener(TABS_VALUE_CHANGE_EVENT, (event) => {
      const { value } = (event as CustomEvent<TabsValueChangeDetail>).detail
      for (const link of navigation.querySelectorAll<HTMLAnchorElement>(
        'a[href]'
      )) {
        if (link.getAttribute('href') !== navigation.dataset.docsAreaTabs)
          continue
        const panel = link.closest<HTMLElement>('[data-slot="tabs-content"]')
        if (panel?.dataset.value === value)
          link.setAttribute('aria-current', 'page')
        else link.removeAttribute('aria-current')
      }
    })
  }

  for (const picker of document.querySelectorAll<HTMLDetailsElement>(
    '.docs-package-picker'
  )) {
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !picker.contains(event.target)) {
        picker.open = false
      }
    })

    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        picker.open = false
        picker.querySelector<HTMLElement>('summary')?.focus()
      }
    })
  }
</script>

<style>
  .docs-package-header {
    padding: 0.5rem 0.625rem;
  }

  .docs-package-picker {
    --package-accent: var(--color-primary-text);
    --package-tint: var(--color-selected-surface);
  }

  .docs-package-selector,
  .docs-package-option {
    &[data-package-kind='ui'] {
      --package-accent: var(--color-success);
      --package-tint: color-mix(
        in oklab,
        var(--color-success) 11%,
        transparent
      );
    }

    &[data-package-kind='cli'] {
      --package-accent: color-mix(
        in oklab,
        var(--color-warning) 78%,
        var(--color-foreground)
      );
      --package-tint: color-mix(
        in oklab,
        var(--color-warning) 14%,
        transparent
      );
    }
  }

  .docs-package-selector {
    display: grid;
    min-height: 3.25rem;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    padding: 0.375rem 0.375rem 0.375rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    cursor: pointer;
    list-style: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .docs-package-selector::-webkit-details-marker {
    display: none;
  }

  .docs-package-selector:hover {
    border-color: color-mix(in oklab, var(--color-border) 70%, transparent);
    background: color-mix(
      in oklab,
      var(--color-surface-raised) 58%,
      transparent
    );
  }

  .docs-package-picker[open] .docs-package-selector {
    border-color: var(--color-border);
    background: color-mix(
      in oklab,
      var(--color-surface-raised) 68%,
      transparent
    );
  }

  .docs-package-selector-icon,
  .docs-package-option-icon {
    display: grid;
    flex: none;
    place-items: center;
    color: var(--package-accent);
    background: var(--package-tint);
  }

  .docs-package-selector-icon {
    width: 2rem;
    height: 2rem;
    border: 1px solid
      color-mix(in oklab, var(--package-accent) 14%, transparent);
    border-radius: 0.55rem;
    box-shadow: inset 0 1px 0 color-mix(in oklab, white 55%, transparent);
  }

  .docs-package-selector-copy,
  .docs-package-option-copy {
    display: grid;
    min-width: 0;
  }

  .docs-package-selector-label,
  .docs-package-menu-heading {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.11em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .docs-package-selector-label {
    color: var(--color-muted-foreground);
  }

  .docs-package-selector-name {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .docs-package-status {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .docs-package-status > span {
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 999px;
    background: var(--package-accent);
    box-shadow: 0 0 0 0.1875rem var(--package-tint);
  }

  .docs-package-chevron {
    display: grid;
    width: 1.625rem;
    height: 1.625rem;
    place-items: center;
    border-radius: 999px;
    color: var(--color-muted-foreground);
    transition:
      color 160ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 160ms ease;
  }

  .docs-package-selector:hover .docs-package-chevron,
  .docs-package-picker[open] .docs-package-chevron {
    color: var(--package-accent);
    background: color-mix(in oklab, var(--package-accent) 9%, transparent);
  }

  .docs-package-picker[open] .docs-package-chevron {
    color: var(--color-foreground);
    background: var(--color-hover-surface);
    transform: rotate(180deg);
  }

  .docs-package-menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.375rem);
    right: 0;
    left: 0;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-floating);
    transform-origin: top center;
  }

  .docs-package-picker[open] .docs-package-menu {
    animation: package-menu-in 150ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .docs-package-menu-heading {
    display: flex;
    justify-content: space-between;
    padding: 0.45rem 0.5rem 0.4rem;
    color: var(--color-muted-foreground);
  }

  .docs-package-menu-heading span:last-child {
    letter-spacing: 0;
    text-transform: none;
  }

  .docs-package-option {
    --package-accent: var(--color-primary-text);
    --package-tint: var(--color-selected-surface);
    display: grid;
    min-height: 3rem;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.625rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .docs-package-option:hover {
    background: var(--color-hover-surface);
  }

  .docs-package-option[aria-current='page'] {
    background: var(--package-tint);
  }

  .docs-package-option-icon {
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 0.5rem;
  }

  .docs-package-option-name {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .docs-package-option-description {
    overflow: hidden;
    color: var(--color-muted-foreground);
    font-size: 0.625rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .docs-package-option-status {
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .docs-package-option-check {
    grid-column: 4;
    color: var(--package-accent);
  }

  @keyframes package-menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .docs-package-menu {
      animation: none !important;
    }

    .docs-package-chevron {
      transition: none;
    }
  }
</style>
