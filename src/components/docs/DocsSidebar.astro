---
import { apiDocs } from '@/data/docs'
import Sidebar from '@/components/sidebar/sidebar.astro'
import SidebarHeader from '@/components/sidebar/sidebar-header.astro'
import SidebarContent from '@/components/sidebar/sidebar-content.astro'
import SidebarGroup from '@/components/sidebar/sidebar-group.astro'
import SidebarGroupLabel from '@/components/sidebar/sidebar-group-label.astro'
import SidebarMenu from '@/components/sidebar/sidebar-menu.astro'
import SidebarMenuItem from '@/components/sidebar/sidebar-menu-item.astro'
import SidebarMenuLink from '@/components/sidebar/sidebar-menu-link.astro'
import Badge from '@/components/badge/badge.astro'
import PackageIcon from '@/components/site/PackageIcon.astro'

type Props = { pathname: string }
const { pathname } = Astro.props

const packages = [
  {
    kind: 'api',
    name: '@hulla/api',
    href: '/docs/api',
    status: 'Beta',
  },
  { kind: 'ui', name: '@hulla/ui', href: '/docs/ui', status: undefined },
  { kind: 'cli', name: 'hulla CLI', href: '/docs/cli', status: undefined },
] as const

const activePackage =
  packages.find(({ href }) => pathname.startsWith(href)) ?? packages[0]
---

<Sidebar
  class="min-[96rem]:bg-transparent"
  aria-label="Package documentation navigation">
  <SidebarHeader>
    <a
      href={activePackage.href}
      class="flex min-h-10 items-center justify-between gap-3 rounded-md px-1.5 no-underline">
      <span class="flex min-w-0 items-center gap-2.5">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-md border border-border bg-surface-raised text-primary-text shadow-control">
          <PackageIcon kind={activePackage.kind} size={17} />
        </span>
        <span class="truncate font-medium">{activePackage.name}</span>
      </span>
      {activePackage.status && <Badge size="sm">{activePackage.status}</Badge>}
    </a>
  </SidebarHeader>
  <SidebarContent>
    <nav aria-label="Documentation">
      <SidebarGroup>
        <SidebarGroupLabel>Packages</SidebarGroupLabel>
        <SidebarMenu>
          {packages.map((pkg) => (
            <SidebarMenuItem>
              <SidebarMenuLink
                href={pkg.href}
                aria-current={
                  activePackage.href === pkg.href ? 'page' : undefined
                }>
                <span class="flex items-center gap-2.5">
                  <PackageIcon kind={pkg.kind} size={16} />
                  <span>{pkg.name}</span>
                </span>
              </SidebarMenuLink>
            </SidebarMenuItem>
          ))}
        </SidebarMenu>
      </SidebarGroup>

      {activePackage.kind === 'api' &&
        apiDocs.map((group) => (
          <SidebarGroup>
            <>
              <SidebarGroupLabel>
                <a href={group.href}>{group.title}</a>
              </SidebarGroupLabel>
              <SidebarMenu>
                {group.entries.map((entry) => (
                  <SidebarMenuItem>
                    <SidebarMenuLink
                      href={entry.href}
                      aria-current={
                        pathname === entry.href ? 'page' : undefined
                      }>
                      {entry.title}
                    </SidebarMenuLink>
                  </SidebarMenuItem>
                ))}
              </SidebarMenu>
            </>
          </SidebarGroup>
        ))}

      {activePackage.kind === 'ui' && (
        <SidebarGroup>
          <SidebarGroupLabel>Overview</SidebarGroupLabel>
          <SidebarMenu>
            <SidebarMenuItem>
              <SidebarMenuLink
                href="/docs/ui"
                aria-current={pathname === '/docs/ui' ? 'page' : undefined}>
                Components & styling
              </SidebarMenuLink>
            </SidebarMenuItem>
          </SidebarMenu>
        </SidebarGroup>
      )}

      {activePackage.kind === 'cli' && (
        <SidebarGroup>
          <SidebarGroupLabel>Overview</SidebarGroupLabel>
          <SidebarMenu>
            <SidebarMenuItem>
              <SidebarMenuLink
                href="/docs/cli"
                aria-current={pathname === '/docs/cli' ? 'page' : undefined}>
                Introduction
              </SidebarMenuLink>
            </SidebarMenuItem>
          </SidebarMenu>
        </SidebarGroup>
      )}
    </nav>
  </SidebarContent>
</Sidebar>
