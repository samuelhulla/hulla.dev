---
import { guides, findGuide } from '@/data/guides'
import { apiDocNavigation, docPackages, findDocPackage } from '@/data/docs'
import Sidebar from '@/components/sidebar/sidebar.astro'
import SidebarHeader from '@/components/sidebar/sidebar-header.astro'
import SidebarContent from '@/components/sidebar/sidebar-content.astro'
import SidebarGroup from '@/components/sidebar/sidebar-group.astro'
import SidebarGroupTrigger from '@/components/sidebar/sidebar-group-trigger.astro'
import SidebarMenu from '@/components/sidebar/sidebar-menu.astro'
import SidebarMenuItem from '@/components/sidebar/sidebar-menu-item.astro'
import SidebarMenuLink from '@/components/sidebar/sidebar-menu-link.astro'
import SidebarMenuTrigger from '@/components/sidebar/sidebar-menu-trigger.astro'
import Collapsible from '@/components/collapsible/collapsible.astro'
import CollapsibleContent from '@/components/collapsible/collapsible-content.astro'
import SidebarTabs from '@/components/sidebar/sidebar-tabs.astro'
import SidebarTabsList from '@/components/sidebar/sidebar-tabs-list.astro'
import TabsTrigger from '@/components/tabs/tabs-trigger.astro'
import TabsContent from '@/components/tabs/tabs-content.astro'
import PackageChooserTrigger from './PackageChooserTrigger.astro'
import {
  BookOpen,
  Braces,
  Cable,
  Layers,
  PlugZap,
  Server,
  SquareTerminal,
} from '@lucide/astro'

type Props = { pathname: string }
const { pathname } = Astro.props

const packages = docPackages
const guide = findGuide(pathname)
const activePackage =
  findDocPackage(guide ? `/docs/${guide.packageKind}` : pathname) ??
  packages[0]!
const documentationGroups = activePackage.groups.filter(
  (group) => group.area !== 'reference'
)
const documentationSections = apiDocNavigation
  .map((section) => ({
    ...section,
    groups: section.groups.filter((group) => group.area !== 'reference'),
  }))
  .filter((section) => section.groups.length > 0)
const activeArea = guide
  ? 'guides'
  : activePackage.groups.some(
        (group) =>
          group.area === 'reference' &&
          (group.href === pathname ||
            group.entries.some((entry) => entry.href === pathname))
      )
    ? 'reference'
    : 'documentation'
const areas = [
  {
    value: 'guides',
    label: 'Guides',
    entries: guides.filter((item) => item.packageKind === activePackage.kind),
  },
  {
    value: 'reference',
    label: 'Reference',
    entries: activePackage.groups
      .filter((group) => group.area === 'reference')
      .flatMap((group) => group.entries),
  },
].filter((area) => area.entries.length > 0)

const sectionIcons = {
  'Start here': BookOpen,
  Fundamentals: Layers,
  Server,
  Client: Cable,
  Integrations: PlugZap,
  'OpenAPI tooling': Braces,
  Reference: SquareTerminal,
} as const
---

<Sidebar
  class="min-[96rem]:bg-transparent"
  aria-label="Package documentation navigation">
  <SidebarHeader>
    <PackageChooserTrigger {activePackage} />
  </SidebarHeader>

  <SidebarTabs defaultValue={activeArea} data-docs-area-tabs={pathname}>
    <SidebarTabsList aria-label="Documentation area">
      <TabsTrigger value="documentation">Docs</TabsTrigger>
      {areas.map((area) => (
        <TabsTrigger value={area.value}>{area.label}</TabsTrigger>
      ))}
    </SidebarTabsList>

    <SidebarContent class="p-3">
      <TabsContent value="documentation" tabindex={0}>
        {activePackage.kind === 'api' && (
          <div class="grid gap-1">
            {documentationSections.map((section) => {
              const isCategory =
                section.groups.length > 1 ||
                section.groups[0]?.title !== section.title
              const isSectionActive = section.groups.some(
                (group) =>
                  pathname === group.href ||
                  group.entries.some((entry) => pathname === entry.href)
              )
              const SectionIcon =
                sectionIcons[section.title as keyof typeof sectionIcons]

              if (isCategory) {
                return (
                  <SidebarGroup class="py-0.5">
                    <Collapsible
                      open={isSectionActive}
                      data-docs-sidebar-group={`section:${section.title.toLowerCase()}`}
                      data-docs-sidebar-package={activePackage.kind}
                      data-docs-sidebar-active={
                        isSectionActive ? 'true' : undefined
                      }>
                      <SidebarGroupTrigger>
                        <SectionIcon
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                        <span>{section.title}</span>
                      </SidebarGroupTrigger>
                      <CollapsibleContent>
                        <SidebarMenu class="mt-0.5" lines="all">
                          {section.groups.map((group) => {
                            const isGroupActive =
                              pathname === group.href ||
                              group.entries.some(
                                (entry) => pathname === entry.href
                              )

                            return (
                              <SidebarMenuItem>
                                <Collapsible
                                  open={isGroupActive}
                                  data-docs-sidebar-group={group.href}
                                  data-docs-sidebar-package={activePackage.kind}
                                  data-docs-sidebar-active={
                                    isGroupActive ? 'true' : undefined
                                  }>
                                  <SidebarMenuTrigger>
                                    {group.title}
                                  </SidebarMenuTrigger>
                                  <CollapsibleContent>
                                    <SidebarMenu>
                                      <SidebarMenuItem>
                                        <SidebarMenuLink
                                          href={group.href}
                                          aria-current={
                                            pathname === group.href
                                              ? 'page'
                                              : undefined
                                          }>
                                          Overview
                                        </SidebarMenuLink>
                                      </SidebarMenuItem>
                                      {group.entries.map((entry) => (
                                        <SidebarMenuItem>
                                          <SidebarMenuLink
                                            href={entry.href}
                                            aria-current={
                                              pathname === entry.href
                                                ? 'page'
                                                : undefined
                                            }>
                                            {entry.title}
                                          </SidebarMenuLink>
                                        </SidebarMenuItem>
                                      ))}
                                    </SidebarMenu>
                                  </CollapsibleContent>
                                </Collapsible>
                              </SidebarMenuItem>
                            )
                          })}
                        </SidebarMenu>
                      </CollapsibleContent>
                    </Collapsible>
                  </SidebarGroup>
                )
              }

              const group = section.groups[0]!
              return (
                <SidebarGroup class="py-0.5">
                  <Collapsible
                    open={isSectionActive}
                    data-docs-sidebar-group={group.href}
                    data-docs-sidebar-package={activePackage.kind}
                    data-docs-sidebar-active={
                      isSectionActive ? 'true' : undefined
                    }>
                    <SidebarGroupTrigger>
                      <SectionIcon
                        size={15}
                        stroke-width={1.7}
                        aria-hidden="true"
                      />
                      <span>{group.title}</span>
                    </SidebarGroupTrigger>
                    <CollapsibleContent>
                      <SidebarMenu class="mt-0.5">
                        <SidebarMenuItem>
                          <SidebarMenuLink
                            href={group.href}
                            aria-current={
                              pathname === group.href ? 'page' : undefined
                            }>
                            Overview
                          </SidebarMenuLink>
                        </SidebarMenuItem>
                        {group.entries.map((entry) => (
                          <SidebarMenuItem>
                            <SidebarMenuLink
                              href={entry.href}
                              aria-current={
                                pathname === entry.href ? 'page' : undefined
                              }>
                              {entry.title}
                            </SidebarMenuLink>
                          </SidebarMenuItem>
                        ))}
                      </SidebarMenu>
                    </CollapsibleContent>
                  </Collapsible>
                </SidebarGroup>
              )
            })}
          </div>
        )}

        {activePackage.kind !== 'api' && (
          <div class="grid gap-1">
            {documentationGroups.map((group) => (
              <SidebarGroup class="py-0.5">
                <Collapsible
                  open
                  data-docs-sidebar-group={group.href}
                  data-docs-sidebar-package={activePackage.kind}
                  data-docs-sidebar-active={
                    group.entries.some((entry) => pathname === entry.href)
                      ? 'true'
                      : undefined
                  }>
                  <SidebarGroupTrigger>
                    <BookOpen size={15} aria-hidden="true" />
                    <span>{group.title}</span>
                  </SidebarGroupTrigger>
                  <CollapsibleContent>
                    <SidebarMenu>
                      {group.entries.map((entry) => (
                        <SidebarMenuItem>
                          <SidebarMenuLink
                            href={entry.href}
                            aria-current={
                              pathname === entry.href ? 'page' : undefined
                            }>
                            {entry.title}
                          </SidebarMenuLink>
                        </SidebarMenuItem>
                      ))}
                    </SidebarMenu>
                  </CollapsibleContent>
                </Collapsible>
              </SidebarGroup>
            ))}
          </div>
        )}
      </TabsContent>

      {areas.map((area) => (
        <TabsContent value={area.value} tabindex={0}>
          <SidebarMenu>
            {area.value === 'guides' && (
              <SidebarMenuItem>
                <SidebarMenuLink href="/guides">All guides</SidebarMenuLink>
              </SidebarMenuItem>
            )}
            {area.entries.map((entry) => (
              <SidebarMenuItem>
                <SidebarMenuLink
                  href={entry.href}
                  aria-current={entry.href === pathname ? 'page' : undefined}>
                  {entry.title}
                </SidebarMenuLink>
              </SidebarMenuItem>
            ))}
          </SidebarMenu>
        </TabsContent>
      ))}
    </SidebarContent>
  </SidebarTabs>
</Sidebar>

<script>
  import { connectDocsSidebarState } from '@/lib/docs-sidebar-state'
  import {
    TABS_VALUE_CHANGE_EVENT,
    type TabsValueChangeDetail,
  } from '@/lib/tabs'

  connectDocsSidebarState()

  for (const navigation of document.querySelectorAll<HTMLElement>(
    '[data-docs-area-tabs]'
  )) {
    navigation.addEventListener(TABS_VALUE_CHANGE_EVENT, (event) => {
      const { value } = (event as CustomEvent<TabsValueChangeDetail>).detail
      for (const link of navigation.querySelectorAll<HTMLAnchorElement>(
        'a[href]'
      )) {
        if (link.getAttribute('href') !== navigation.dataset.docsAreaTabs)
          continue
        const panel = link.closest<HTMLElement>('[data-slot="tabs-content"]')
        if (panel?.dataset.value === value)
          link.setAttribute('aria-current', 'page')
        else link.removeAttribute('aria-current')
      }
    })
  }
</script>
