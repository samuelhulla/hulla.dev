---
import { apiDocs } from '@/data/docs'
import Sidebar from '@/components/sidebar/sidebar.astro'
import SidebarHeader from '@/components/sidebar/sidebar-header.astro'
import SidebarContent from '@/components/sidebar/sidebar-content.astro'
import SidebarGroup from '@/components/sidebar/sidebar-group.astro'
import SidebarGroupTrigger from '@/components/sidebar/sidebar-group-trigger.astro'
import SidebarMenu from '@/components/sidebar/sidebar-menu.astro'
import SidebarMenuItem from '@/components/sidebar/sidebar-menu-item.astro'
import SidebarMenuLink from '@/components/sidebar/sidebar-menu-link.astro'
import Collapsible from '@/components/collapsible/collapsible.astro'
import CollapsibleContent from '@/components/collapsible/collapsible-content.astro'
import Tabs from '@/components/tabs/tabs.astro'
import TabsList from '@/components/tabs/tabs-list.astro'
import TabsTrigger from '@/components/tabs/tabs-trigger.astro'
import TabsContent from '@/components/tabs/tabs-content.astro'
import Badge from '@/components/badge/badge.astro'
import PackageIcon from '@/components/site/PackageIcon.astro'
import {
  BookOpen,
  Braces,
  Cable,
  ChevronDown,
  CloudCog,
  Layers,
  PanelsTopLeft,
  PlugZap,
  Server,
  SquareTerminal,
} from '@lucide/astro'

type Props = { pathname: string }
const { pathname } = Astro.props

const packages = [
  {
    kind: 'api',
    name: '@hulla/api',
    href: '/docs/api',
    status: 'Beta',
  },
  { kind: 'ui', name: '@hulla/ui', href: '/docs/ui', status: undefined },
  { kind: 'cli', name: 'hulla CLI', href: '/docs/cli', status: undefined },
] as const

const activePackage =
  packages.find(({ href }) => pathname.startsWith(href)) ?? packages[0]
---

<Sidebar
  class="min-[96rem]:bg-transparent"
  aria-label="Package documentation navigation">
  <SidebarHeader class="relative p-3">
    <details class="group/package-selector relative">
      <summary class="docs-package-selector flex min-h-11 list-none items-center gap-2.5 rounded-lg border border-border bg-surface-raised px-2.5 text-sm shadow-control transition-colors hover:border-foreground/25 hover:bg-hover-surface [&::-webkit-details-marker]:hidden">
        <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-selected-surface text-primary-text">
          <PackageIcon kind={activePackage.kind} size={16} />
        </span>
        <span class="min-w-0 flex-1 truncate font-semibold tracking-[-0.02em]">
          {activePackage.name}
        </span>
        {activePackage.status && (
          <Badge size="sm">{activePackage.status}</Badge>
        )}
        <ChevronDown
          size={14}
          aria-hidden="true"
          class="shrink-0 text-muted-foreground transition-transform duration-150 group-open/package-selector:rotate-180"
        />
      </summary>
      <div class="absolute top-[calc(100%+0.375rem)] right-0 left-0 z-20 rounded-lg border border-border bg-surface-raised p-1.5 shadow-floating">
        <p class="px-2 py-1.5 font-mono text-[0.625rem] tracking-[0.09em] text-muted-foreground uppercase">
          Switch package
        </p>
        {packages.map((pkg) => (
          <a
            href={pkg.href}
            aria-current={pkg.href === activePackage.href ? 'page' : undefined}
            class="flex min-h-9 items-center gap-2.5 rounded-md px-2 text-sm no-underline hover:bg-hover-surface aria-[current=page]:bg-selected-surface aria-[current=page]:text-primary-text">
            <PackageIcon kind={pkg.kind} size={15} />
            <span class="flex-1">{pkg.name}</span>
            {pkg.status && (
              <span class="text-[0.65rem] text-muted-foreground">
                {pkg.status}
              </span>
            )}
          </a>
        ))}
      </div>
    </details>
  </SidebarHeader>

  <SidebarContent class="p-3">
    <Tabs defaultValue="documentation" class="gap-2">
      <TabsList aria-label="Documentation area" class="docs-area-tabs">
        <TabsTrigger value="documentation" class="docs-area-tab">
          Documentation
        </TabsTrigger>
        <TabsTrigger value="guides" class="docs-area-tab">
          Guides
        </TabsTrigger>
        <TabsTrigger value="reference" class="docs-area-tab">
          Reference
        </TabsTrigger>
      </TabsList>

      <TabsContent value="documentation" class="pt-1" tabindex={0}>
        {activePackage.kind === 'api' && (
          <div class="grid gap-1">
            {apiDocs.map((group) => {
              const isActive =
                pathname === group.href ||
                group.entries.some((entry) => pathname === entry.href)
              return (
                <SidebarGroup class="py-0.5">
                  <Collapsible
                    open={isActive}
                    data-docs-sidebar-group={group.href}
                    data-docs-sidebar-package={activePackage.kind}
                    data-docs-sidebar-active={isActive ? 'true' : undefined}>
                    <SidebarGroupTrigger class="min-h-9 rounded-md px-2 text-[0.65rem]">
                      {group.title === 'Start here' && (
                        <BookOpen
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                      )}
                      {group.title === 'Core API' && (
                        <Layers
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                      )}
                      {group.title === 'Transports' && (
                        <Cable
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                      )}
                      {group.title === 'Server frameworks' && (
                        <Server
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                      )}
                      {group.title === 'Full-stack frameworks' && (
                        <PanelsTopLeft
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                      )}
                      {group.title === 'Serverless & runtimes' && (
                        <CloudCog
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                      )}
                      {group.title === 'Integrations' && (
                        <PlugZap
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                      )}
                      {group.title === 'Architecture & exports' && (
                        <Braces
                          size={15}
                          stroke-width={1.7}
                          aria-hidden="true"
                        />
                      )}
                      <span>{group.title}</span>
                    </SidebarGroupTrigger>
                    <CollapsibleContent>
                      <SidebarMenu class="mt-0.5">
                        {group.entries.map((entry) => (
                          <SidebarMenuItem>
                            <SidebarMenuLink
                              href={entry.href}
                              aria-current={
                                pathname === entry.href ? 'page' : undefined
                              }>
                              {entry.title}
                            </SidebarMenuLink>
                          </SidebarMenuItem>
                        ))}
                      </SidebarMenu>
                    </CollapsibleContent>
                  </Collapsible>
                </SidebarGroup>
              )
            })}
          </div>
        )}

        {activePackage.kind === 'ui' && (
          <SidebarGroup class="py-0.5">
            <Collapsible
              open
              data-docs-sidebar-group="/docs/ui"
              data-docs-sidebar-package={activePackage.kind}
              data-docs-sidebar-active="true">
              <SidebarGroupTrigger>
                <PanelsTopLeft size={15} aria-hidden="true" />
                <span>Components</span>
              </SidebarGroupTrigger>
              <CollapsibleContent>
                <SidebarMenu>
                  <SidebarMenuItem>
                    <SidebarMenuLink
                      href="/docs/ui"
                      aria-current={
                        pathname === '/docs/ui' ? 'page' : undefined
                      }>
                      Components & styling
                    </SidebarMenuLink>
                  </SidebarMenuItem>
                </SidebarMenu>
              </CollapsibleContent>
            </Collapsible>
          </SidebarGroup>
        )}

        {activePackage.kind === 'cli' && (
          <SidebarGroup class="py-0.5">
            <Collapsible
              open
              data-docs-sidebar-group="/docs/cli"
              data-docs-sidebar-package={activePackage.kind}
              data-docs-sidebar-active="true">
              <SidebarGroupTrigger>
                <SquareTerminal size={15} aria-hidden="true" />
                <span>CLI</span>
              </SidebarGroupTrigger>
              <CollapsibleContent>
                <SidebarMenu>
                  <SidebarMenuItem>
                    <SidebarMenuLink
                      href="/docs/cli"
                      aria-current={
                        pathname === '/docs/cli' ? 'page' : undefined
                      }>
                      Introduction
                    </SidebarMenuLink>
                  </SidebarMenuItem>
                </SidebarMenu>
              </CollapsibleContent>
            </Collapsible>
          </SidebarGroup>
        )}
      </TabsContent>

      <TabsContent value="guides" aria-label="No guides published yet" />
      <TabsContent
        value="reference"
        aria-label="No API reference published yet"
      />
    </Tabs>
  </SidebarContent>
</Sidebar>

<script>
  import { connectDocsSidebarState } from '@/lib/docs-sidebar-state'

  connectDocsSidebarState()
</script>
