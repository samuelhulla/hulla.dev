---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'header'>

const { class: className, ...props } = Astro.props as Props
---

<header
  {...props}
  data-slot="card-header"
  class={cn('grid gap-1.5', className)}>
  <slot />
</header>
