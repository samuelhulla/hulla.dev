---
import {
  Braces,
  Download,
  Database,
  GitBranch,
  Paintbrush,
  PanelsTopLeft,
  SquareTerminal,
  Waypoints,
} from '@lucide/astro'
import type { DocPackage } from '@/data/docs'
import { cn } from '@/lib/style'

type Props = {
  kind: DocPackage['kind']
  size?: number
  class?: string
}

const { kind, size = 18, class: className } = Astro.props
const icons = {
  api: Waypoints,
  ui: PanelsTopLeft,
  cli: SquareTerminal,
  control: GitBranch,
  style: Paintbrush,
  db: Database,
  args: Braces,
  gittar: Download,
} as const
const Icon = icons[kind]
---

<Icon
  size={size}
  stroke-width={1.75}
  aria-hidden="true"
  class={cn('shrink-0', className)}
/>
