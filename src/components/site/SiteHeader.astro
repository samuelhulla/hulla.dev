---
import ThemeToggle from './ThemeToggle.astro'
import GitHubIcon from './GitHubIcon.astro'
const docs = Astro.url.pathname.startsWith('/docs')
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label="hulla.dev home">
      <img
        class="site-brand-mark"
        src="/favicon.svg"
        width="28"
        height="28"
        alt=""
      />
      <span>
        hulla<span class="site-brand-dot">.</span>dev
      </span>
    </a>
    <nav class="site-links" aria-label="Main navigation">
      {!docs && (
        <a class="site-nav-link" href="/docs">
          Docs
        </a>
      )}
      {!docs && (
        <a class="site-nav-link hidden sm:inline" href="/cv">
          CV
        </a>
      )}
      <slot />
      <a
        class="site-icon-link"
        href="https://github.com/hulladev"
        aria-label="GitHub"
        title="GitHub">
        <GitHubIcon size={18} />
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
