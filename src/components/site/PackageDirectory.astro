---
import LinkCard from '@/components/link-card/link-card.astro'
import LinkCardContent from '@/components/link-card/link-card-content.astro'
import LinkCardTitle from '@/components/link-card/link-card-title.astro'
import LinkCardDescription from '@/components/link-card/link-card-description.astro'
import PackageIcon from './PackageIcon.astro'
import { ArrowRight } from '@lucide/astro'
import { docPackages } from '@/data/docs'
import { packagePreviews } from '@/data/package-previews'
---

<nav aria-label="Package documentation" class="package-directory">
  {docPackages.map((pkg) => (
    <LinkCard href={pkg.href}>
      <PackageIcon kind={pkg.kind} class="text-muted-foreground mt-1" />
      <LinkCardContent>
        <LinkCardTitle>
          <span class="font-mono">{pkg.title}</span>
        </LinkCardTitle>
        <LinkCardDescription>
          {packagePreviews[pkg.kind].summary}
        </LinkCardDescription>
        <span class="mt-2 inline-flex items-center gap-2 text-sm font-medium">
          Read documentation <ArrowRight size={14} aria-hidden="true" />
        </span>
      </LinkCardContent>
    </LinkCard>
  ))}
</nav>

<style>
  .package-directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
  }
  @media (max-width: 639px) {
    .package-directory {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
