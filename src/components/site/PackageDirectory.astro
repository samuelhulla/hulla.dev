---
import NavigationLink from '@/components/navigation-menu/navigation-menu-link.astro'
import LinkContent from '@/components/navigation-menu/navigation-menu-link-content.astro'
import LinkTitle from '@/components/navigation-menu/navigation-menu-link-title.astro'
import LinkDescription from '@/components/navigation-menu/navigation-menu-link-description.astro'
import PackageIcon from './PackageIcon.astro'
import { ArrowRight } from '@lucide/astro'
import { docPackages } from '@/data/docs'
import { packagePreviews } from '@/data/package-previews'
---

<nav aria-label="Package documentation" class="package-directory">
  {docPackages.map((pkg) => (
    <NavigationLink href={pkg.href}>
      <PackageIcon kind={pkg.kind} class="text-muted-foreground mt-1" />
      <LinkContent>
        <LinkTitle>
          <span class="font-mono">{pkg.title}</span>
        </LinkTitle>
        <LinkDescription>{packagePreviews[pkg.kind].summary}</LinkDescription>
        <span class="mt-2 inline-flex items-center gap-2 text-sm font-medium">
          Read documentation <ArrowRight size={14} aria-hidden="true" />
        </span>
      </LinkContent>
    </NavigationLink>
  ))}
</nav>

<style>
  .package-directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
  }
  @media (max-width: 639px) {
    .package-directory {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
