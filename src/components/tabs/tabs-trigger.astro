---
import { cn } from '@/lib/style'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'button'> & {
  value: string
}

const {
  class: className,
  role = 'tab',
  tabindex = -1,
  type = 'button',
  value,
  ...props
} = Astro.props as Props
---

<button
  {...props}
  type={type}
  role={role}
  value={value}
  aria-selected="false"
  tabindex={tabindex}
  data-slot="tabs-trigger"
  data-value={value}
  class={cn(
    "relative inline-flex min-h-10 flex-none select-none items-center justify-center gap-2 whitespace-nowrap rounded-t-sm border-0 bg-transparent px-3 py-2 text-sm font-medium leading-none tracking-[-0.01em] text-muted-foreground transition-[background-color,color] duration-150 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-center after:scale-x-0 after:rounded-full after:bg-primary after:opacity-0 after:transition-[scale,opacity] after:duration-150 after:ease-out after:content-[''] enabled:hover:bg-hover-surface enabled:hover:text-foreground focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-focus-ring enabled:data-[state=active]:bg-selected-surface enabled:data-[state=active]:hover:bg-selected-hover-surface enabled:data-[state=active]:text-primary-text data-[state=active]:after:scale-x-100 data-[state=active]:after:opacity-100 disabled:cursor-not-allowed disabled:text-disabled-foreground disabled:after:bg-disabled-foreground motion-reduce:transition-none motion-reduce:after:transition-none group-data-[orientation=vertical]/tabs-list:w-full group-data-[orientation=vertical]/tabs-list:justify-start group-data-[orientation=vertical]/tabs-list:rounded-r-none group-data-[orientation=vertical]/tabs-list:rounded-l-sm group-data-[orientation=vertical]/tabs-list:after:inset-y-0 group-data-[orientation=vertical]/tabs-list:after:right-0 group-data-[orientation=vertical]/tabs-list:after:left-auto group-data-[orientation=vertical]/tabs-list:after:h-auto group-data-[orientation=vertical]/tabs-list:after:w-0.5 group-data-[orientation=vertical]/tabs-list:after:scale-x-100 group-data-[orientation=vertical]/tabs-list:after:scale-y-0 group-data-[orientation=vertical]/tabs-list:data-[state=active]:after:scale-y-100",
    className
  )}>
  <slot />
</button>
